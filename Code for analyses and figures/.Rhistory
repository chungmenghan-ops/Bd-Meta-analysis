#######################################
### Tree (p) + species name = p2 ######
#######################################
p2 <- p +
geom_tiplab(aes(label = label), size = 1, offset = 0.2, align = FALSE, fontface = "italic", family = "sans") +
theme(plot.margin = margin(50, 50, 50, 50))
# eps: how much to stretch zero-length edges so they're visible
eps <- 0.05 * max(node.depth.edgelength(tree2))  # scale to tree depth
# catch every edge that's exactly zero, tip or internal
zero_edges <- tree2$edge.length == 0
tree2$edge.length[zero_edges] <- eps
# --- re-align tips so they all end at the same depth (restore ultrametric look) ---
depths <- node.depth.edgelength(tree2)[1:Ntip(tree2)]   # root-to-tip depth for each tip
target_depth <- max(depths)
tip_edge_idx <- match(1:Ntip(tree2), tree2$edge[,2])    # pendant edge row for each tip
correction <- target_depth - depths
tree2$edge.length[tip_edge_idx] <- tree2$edge.length[tip_edge_idx] + correction
# Plot
p <- ggtree(tree2, layout = "rectangular") +
geom_tree(linewidth = 0.4) +
theme(
plot.margin = margin(5, 5, 5, 5),
legend.position = "none"
)
p
