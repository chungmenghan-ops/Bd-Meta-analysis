###############################
## Figure 2 - phylogeny tree ##
###############################
```{r}
# Load the metadata and tree
amphib_tax <- read.csv("metadata.csv")
tree <- read.tree("tree_for_imputation.tre")
list <- read.csv("AmphibiaWeb_species_list.csv", stringsAsFactors = FALSE)
############################################################################################################
# update the species name of the tree based on AmphibiaWeb_species_list (from input_name to accepted_name) #
############################################################################################################
library(ape)
###############################
## Figure 2 - phylogeny tree ##
###############################
# Load the metadata and tree
amphib_tax <- read.csv("metadata.csv")
tree <- read.tree("tree_for_imputation.tre")
list <- read.csv("AmphibiaWeb_species_list.csv", stringsAsFactors = FALSE)
############################################################################################################
# update the species name of the tree based on AmphibiaWeb_species_list (from input_name to accepted_name) #
############################################################################################################
library(ape)
# Create lookup vector
lookup <- setNames(list$accepted_name, list$input_name)
# Convert tree names to species format
tips <- gsub("_", " ", tree$tip.label)
# Replace names
tips_updated <- ifelse(
tips %in% names(lookup),
lookup[tips],
tips
)
# Convert back to tree format
tree$tip.label <- gsub(" ", "_", tips_updated)
#########################################################
## Prune the tree according to species in the metadata ##
#########################################################
# Species set from my metadata
sp_data <- unique(trimws(gsub("\\s+", " ", amphib_tax$AmphibiaWeb_species)))
sp_data_treefmt <- gsub(" ", "_", sp_data)  # match typical tree tip style
# Check the mismatch between species in the metadata and species in existing tree
sp_tree_spaces <- gsub("_", " ", tree$tip.label)
setdiff(sp_data, sp_tree_spaces) # In data but not in tree
# Prune the tree: only keep species present in BOTH tree and my metadata
tips_to_keep <- intersect(tree$tip.label, sp_data_treefmt)
tree_pruned0 <- keep.tip(tree, tips_to_keep)
# Force the tree to be binary
tree_pruned <- multi2di(tree_pruned0)
is.binary (tree_pruned)
# Create a column in metadata that matches the tree’s tip-label format
amphib_tax$species <- gsub(" ", "_", trimws(amphib_tax$host_species))
# tidy ordering (apply in place so it actually takes effect)
tree_pruned <- ape::ladderize(tree_pruned)
# Replace underscores in species names
tree_pruned$tip.label <- gsub("_", " ", tree_pruned$tip.label)
##########################
#### A Basic tree (p) ####
##########################
library(ape)
library(ggtree)
## improve the visualisation of the tree
min.pos <- min(tree_pruned$edge.length[tree_pruned$edge.length > 0])
eps <- min.pos
tree2 <- tree_pruned
internal <- tree2$edge[,2] > Ntip(tree2)
zero_internal <- internal & tree2$edge.length == 0
tree2$edge.length[zero_internal] <- eps
# Plot
p <- ggtree(tree2, layout = "rectangular") +
geom_tree(linewidth = 0.4) +
theme(
plot.margin = margin(5, 5, 5, 5),
legend.position = "none"
)
p
