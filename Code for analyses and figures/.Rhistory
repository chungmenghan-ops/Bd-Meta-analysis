data = intensity_data_NTV) ## matrix
######################################
## Random factor: observation-level ##
######################################
intensity_data_NTV$obs <- 1:nrow(intensity_data_NTV)
#################################
## Non-independence: phylogeny ##
#################################
# Species set from this filtered metadata
sp_data <- unique(trimws(gsub("\\s+", " ", intensity_data_NTV$host_species)))
sp_data_treefmt <- gsub(" ", "_", sp_data)  # match typical tree tip style
# Prune the tree: only keep species present in BOTH tree and the filtered metadata
tips_to_keep <- intersect(tree$tip.label, sp_data_treefmt)
tree_pruned0 <- keep.tip(tree, tips_to_keep)
# Force the tree to be binary
tree_pruned_NTV <- multi2di(tree_pruned0)
is.binary (tree_pruned_NTV) # yes, the tree is binary
# Create correlation phylogeny matrix for analysis
phylo_cor_NTV <- vcv(tree_pruned_NTV, cor = T)
# Create a column in metadata that matches the tree’s tip-label format
intensity_data_NTV$species_OTL <- gsub(" ", "_", trimws(intensity_data_NTV$host_species))
#########################################
### Moderating effect: Overall effect ###
#########################################
M3_NTV <- rma.mv(yi = yi, V = V,
mods = ~  1,
random = list(~1 | study_id, ~1 | species_OTL, ~1 | obs),
R = list(species_OTL = phylo_cor_NTV),
data = intensity_data_NTV,
method = "REML", test = "t")
summary (M3_NTV)
predict (M3_NTV)
###########################################
### Moderating effect: immunisation type ##
###########################################
# Set as a factor
intensity_data_NTV$treatment <- factor(
intensity_data_NTV$treatment,
levels = c("other", "probiotic", "synthetic_antiparastics","natural_chem", "dead_pathogen", "live_pathogen"))
## Analysis: test for individual effect of treatment type
M_T_NTV <- rma.mv(yi = yi, V = V,
mods = ~  -1 + treatment,
random = list(~1 | study_id, ~1 | species_OTL, ~1 | obs),
R = list(species_OTL = phylo_cor_NTV),
data = intensity_data_NTV,
method = "REML", test = "t")
summary (M_T_NTV)
## Prediction intervals
intensity_data_NTV$treatment <- droplevels(factor(intensity_data_NTV$treatment))
levs <- levels(intensity_data_NTV$treatment)
newdat <- data.frame(treatment = factor(levs, levels = levs))
Xnew <- model.matrix(~ -1 + treatment, data = newdat)
pred <- predict(M_T_NTV, newmods = Xnew)
out_M_T_NTV <- data.frame(treatment = levs, as.data.frame(pred))
out_M_T_NTV[-1] <- round(out_M_T_NTV[-1], 4)
out_M_T_NTV
# Check k per treatment type after excluding the transformed value
count <- intensity_data_NTV %>% group_by(treatment) %>% summarise(total_k = n(),.groups = "drop")
count
