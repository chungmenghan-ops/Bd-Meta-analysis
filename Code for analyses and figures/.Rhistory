# eps: how much to stretch zero-length edges so they're visible
eps <- 0.005 * max(node.depth.edgelength(tree2))  # scale to tree depth
# catch every edge that's exactly zero, tip or internal
zero_edges <- tree2$edge.length == 0
tree2$edge.length[zero_edges] <- eps
# Plot
p <- ggtree(tree2, layout = "rectangular") +
geom_tree(linewidth = 0.4) +
theme(
plot.margin = margin(5, 5, 5, 5),
legend.position = "none"
)
