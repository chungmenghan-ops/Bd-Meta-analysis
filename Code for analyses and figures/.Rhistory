library(ggtree)
## improve the visualisation of the tree
min.pos <- min(tree_pruned$edge.length[tree_pruned$edge.length > 0])
eps <- min.pos
tree2 <- tree_pruned
internal <- tree2$edge[,2] > Ntip(tree2)
zero_internal <- internal & tree2$edge.length == 0
tree2$edge.length[zero_internal] <- eps
# Plot
p <- ggtree(tree2, layout = "rectangular") +
geom_tree(linewidth = 0.4) +
theme(
plot.margin = margin(5, 5, 5, 5),
legend.position = "none"
)
p
## improve the visualisation of the tree
